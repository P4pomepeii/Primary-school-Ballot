frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/next.config.js
!frontend/tsconfig.json
!frontend/app/
!frontend/app/**
**/__pycache__
**/node_modules
**/.next
**/venv
**/.venv
**/.git
**/.pytest_cache
**/*.pyc
**/.env*
**/.DS_Store
